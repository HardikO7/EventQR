# EventQR Environment Variables Template
SECRET_KEY=change-this-secret-key

# MySQL Database (Local MySQL or Cloud TiDB Serverless)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=eventqr_db
DB_SSL=auto

# Email Configuration (smtplib)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=eventqr.pu@gmail.com
MAIL_SIMULATION_MODE=true
