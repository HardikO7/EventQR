# ==============================================================================
# EventQR Git Ignore Policy - Strict Privacy & Security
# ==============================================================================

# Environment variables & secrets (NEVER commit credentials or app passwords)
.env
.env.*
!.env.example

# Local SQLite databases (contain real student data, tokens & password hashes)
*.db
*.sqlite
*.sqlite3
eventqr.db

# Dynamic runtime email receipts (contains real OTPs dispatched during testing)
static/email_receipts/*
!static/email_receipts/.gitkeep

# Dynamic generated QR codes and student admission passes
static/qr_codes/*
!static/qr_codes/.gitkeep

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# Matplotlib & imaging caches
.mpl_cache/
.pytest_cache/

# Microsoft Office temporary lock & auto-recovery files
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx
EventQR_Comprehensive_Project_Report_Updated.docx

# Scratch testing & experiment scripts
test_*.py
test_*.docx
test_*.pdf
test_*.png

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
*.log
